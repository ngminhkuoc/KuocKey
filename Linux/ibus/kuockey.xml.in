<?xml version="1.0" encoding="utf-8"?>
<component>
  <name>org.freedesktop.IBus.KuocKey</name>
  <description>KuocKey - Vietnamese input with automatic English/Vietnamese switching</description>
  <exec>@CMAKE_INSTALL_FULL_LIBEXECDIR@/ibus-engine-kuockey --ibus</exec>
  <version>@KUOCKEY_VERSION@</version>
  <author>Tony Dinh, Quoc Nguyen</author>
  <license>GPL-3.0</license>
  <homepage>https://kuockey.quocnguyen.dev</homepage>
  <textdomain>kuockey</textdomain>
  <engines>
    <engine>
      <name>kuockey</name>
      <language>vi</language>
      <license>GPL-3.0</license>
      <author>Tony Dinh, Quoc Nguyen</author>
      <icon>kuockey</icon>
      <layout>default</layout>
      <longname>KuocKey</longname>
      <description>KuocKey - Gõ tiếng Việt, tự chuyển Anh/Việt</description>
      <rank>99</rank>
      <symbol>V</symbol>
      <setup>@CMAKE_INSTALL_FULL_BINDIR@/kuockey-settings</setup>
    </engine>
  </engines>
</component>
